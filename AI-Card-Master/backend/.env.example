# ==============================
# AI-Card-Master backend config
# ==============================

# Environment
APP_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_card_master

# JWT (must be strong, random, and at least 64 chars)
JWT_SECRET_KEY=replace_with_a_strong_random_secret_at_least_64_characters_long
JWT_ALGORITHM=HS512
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=ai-card-master-api
JWT_AUDIENCE=ai-card-master-clients

# Optional in development; REQUIRED in production (≥ 32 chars).
PASSWORD_PEPPER=

# Argon2id profile (tune for your hardware)
ARGON2_MEMORY_COST_KIB=131072
ARGON2_TIME_COST=4
ARGON2_PARALLELISM=4

# CORS — explicit frontend origins only (no wildcard in production).
# ALLOWED_ORIGINS is preferred; CORS_ORIGINS remains as a legacy alias.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,Origin,X-Request-Id,X-Visitor-Id,Idempotency-Key,X-Idempotency-Key,X-API-Key,X-Webhook-Token,X-Webhook-Signature
CORS_EXPOSE_HEADERS=X-Request-Id,Retry-After,X-Idempotency-Replayed

# ==============================
# Legal / GDPR (Terms + Privacy)
# Required for payment acceptance — replace placeholders before production.
# ==============================
SERVICE_DISPLAY_NAME=AI-Card-Master
PUBLIC_SITE_URL=https://ai-card-master.example
LEGAL_OPERATOR_NAME=[УКАЖИТЕ ЮРИДИЧЕСКОЕ НАИМЕНОВАНИЕ ОПЕРАТОРА]
LEGAL_OPERATOR_ADDRESS=[УКАЖИТЕ ЮРИДИЧЕСКИЙ АДРЕС ОПЕРАТОРА]
LEGAL_JURISDICTION=Российская Федерация
SUPPORT_EMAIL=support@example.com
PRIVACY_EMAIL=privacy@example.com
LEGAL_DOCUMENTS_EFFECTIVE_DATE=2026-08-07

# Hidden admin API. Set to your exact user UUID; empty disables /api/v1/admin.
ADMIN_ALLOWED_USER_ID=

# ==============================
# Security layer (plan §14 + Great Wall §61)
# ==============================
SECURITY_SUSPICIOUS_MIDDLEWARE_ENABLED=true
SECURITY_INPUT_SANITIZATION_ENABLED=true
SECURITY_REJECT_PROMPT_INJECTION=true
# Block XSS probes in path/query/JSON bodies (Great Wall)
SECURITY_XSS_PROTECTION_ENABLED=true
# Per-IP request budget (Redis). Fail-closed (HTTP 503) if Redis is down,
# except public healthcheck paths which remain fail-open.
SECURITY_RATE_LIMIT_PER_MINUTE=120
# Cascading slowapi limits (Redis security store). Applied in addition to Great Wall.
SLOWAPI_ENABLED=true
# Global: 100 req/min per IP on public endpoints
SLOWAPI_GLOBAL_PER_MINUTE=100
# Auth login+register: 5 req/min per IP (shared brute-force bucket)
SLOWAPI_AUTH_PER_MINUTE=5
# Generations: 10 req/min per authenticated user_id
SLOWAPI_GENERATIONS_PER_MINUTE=10
# Redis idempotency for coin charges / generation creates (X-Idempotency-Key).
IDEMPOTENCY_MIDDLEWARE_ENABLED=true
# In-flight PROCESSING marker TTL → concurrent retries get HTTP 409
IDEMPOTENCY_PROCESSING_TTL_SECONDS=60
# Cached successful response TTL (replay without AI / backend logic)
IDEMPOTENCY_RESPONSE_TTL_SECONDS=900
# Per API-key / Bearer fingerprint budget (0 = disable API-key bucket)
SECURITY_API_KEY_RATE_LIMIT_PER_MINUTE=300
# Auto-ban IP (+ API key on key breach) when Redis rate limit is exceeded
SECURITY_RATE_LIMIT_AUTO_BAN_ENABLED=true
# Telegram operator alert on auto-ban (uses TELEGRAM_ERROR_* credentials)
SECURITY_TELEGRAM_BAN_ALERTS_ENABLED=true
# Auto temp-ban after N threat hits within 1 hour
SECURITY_AUTO_BLOCK_THREAT_SCORE=5
SECURITY_IP_BLOCK_TTL_SECONDS=3600
SECURITY_MAX_JSON_BODY_BYTES=1048576
# Network-level body gate: Content-Length + streamed size → HTTP 413
SECURITY_PAYLOAD_SIZE_LIMITER_ENABLED=true
# Default max request body (5 MiB)
SECURITY_MAX_PAYLOAD_BYTES=5242880
# Image upload routes (10 MiB); generation/bulk use their own feature ceilings
SECURITY_MAX_UPLOAD_PAYLOAD_BYTES=10485760
# Behavioral generation abuse → HTTP 429 + code CAPTCHA_REQUIRED (plan §35)
SECURITY_BEHAVIORAL_RATE_ENABLED=true
# Max generation *starts* per visitorId (or user) inside the window — credits do not bypass
SECURITY_GENERATION_REQUESTS_PER_MINUTE=8
SECURITY_GENERATION_RATE_WINDOW_SECONDS=60
SECURITY_CAPTCHA_BLOCK_TTL_SECONDS=900
# auto | turnstile | recaptcha
CAPTCHA_PROVIDER=auto
TURNSTILE_SECRET_KEY=
RECAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_TIMEOUT_SECONDS=8
# Local/dev only — never enable in production
CAPTCHA_BYPASS_WHEN_UNCONFIGURED=false
# Extra reverse-proxy CIDRs that may set X-Forwarded-For / CF-Connecting-IP
TRUSTED_PROXY_CIDRS=

# Cloudflare (orange-cloud DNS + origin allowlist CF IPs only — hide real IP / DDoS)
# Great Wall pushes Firewall Access Rules via API when auto-ban fires.
CLOUDFLARE_ENABLED=false
# Production: reject direct-to-origin traffic missing CF-Ray / CF-Connecting-IP
CLOUDFLARE_ENFORCE_EDGE=false
CLOUDFLARE_TRUST_HEADERS=true
CLOUDFLARE_AUTO_BAN_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com
CLOUDFLARE_TIMEOUT_SECONDS=10
# Cloudflare Tunnel token (Zero Trust). Prefer over exposing :80 to CF CIDRs.
CLOUDFLARE_TUNNEL_TOKEN=

# VPN gateway CIDRs (WireGuard) — allowed during Dead Man's Switch lockdown
VPN_GATEWAY_CIDRS=10.8.0.0/24,10.7.0.0/24,fd42:42:42::/64
# Host UFW SSH allowlist (comma CIDRs). Empty = VPN iface only after harden_host.sh
SSH_ALLOW_CIDRS=

# Dead Man's Switch — Postgres password brute-force → block external + Telegram
# See deploy/PRIVATE_TUNNEL.md
DEAD_MANS_SWITCH_ENABLED=true
DEAD_MANS_SWITCH_FAIL_THRESHOLD=5
DEAD_MANS_SWITCH_WINDOW_SECONDS=60
DEAD_MANS_SWITCH_REDIS_KEY=security:dead_mans_switch
DEAD_MANS_SWITCH_CLOUDFLARE_UNDER_ATTACK=true
DEAD_MANS_SWITCH_RUN_HOST_LOCKDOWN=false
DEAD_MANS_SWITCH_LOCKDOWN_SCRIPT=/usr/local/sbin/ai-card-lockdown.sh
DEAD_MANS_SWITCH_UNLOCK_SCRIPT=/usr/local/sbin/ai-card-unlock.sh
# Watchdog: ADMIN_PANEL_URL=http://10.8.0.1:8100 ADMIN_PANEL_TOKEN=adm.v1....
#   python deploy/dead_mans_watchdog.py --log /var/log/postgresql/postgresql-16-main.log

# Isolated admin microservice (AES-256-GCM token; not user JWT).
# REQUIRED in production and must differ from JWT_SECRET_KEY (no fallback).
# Bind to localhost / private net only; put behind VPN or Cloudflare Access.
ADMIN_PANEL_TOKEN_SECRET=replace_with_a_separate_strong_secret_at_least_32_chars
ADMIN_PANEL_BIND_HOST=127.0.0.1
ADMIN_PANEL_PORT=8100
ADMIN_PANEL_CORS_ORIGINS=
# Mint token:  python -m admin_microservice.mint_token --label ops --ttl-days 30
# Run:         uvicorn admin_microservice.main:app --host 127.0.0.1 --port 8100

# Stable Diffusion (Free tariff / fallback engine)
STABLE_DIFFUSION_API_KEY=
STABLE_DIFFUSION_BASE_URL=https://api.stability.ai
STABLE_DIFFUSION_ENGINE_ID=stable-diffusion-xl-1024-v1-0
STABLE_DIFFUSION_TIMEOUT_SECONDS=60
STABLE_DIFFUSION_CONNECT_TIMEOUT_SECONDS=8
STABLE_DIFFUSION_MAX_CONNECTIONS=300
STABLE_DIFFUSION_MAX_KEEPALIVE_CONNECTIONS=120
STABLE_DIFFUSION_KEEPALIVE_EXPIRY_SECONDS=30
STABLE_DIFFUSION_MAX_PARALLEL_REQUESTS=200
STABLE_DIFFUSION_MAX_RETRIES=3
STABLE_DIFFUSION_BASE_RETRY_DELAY_SECONDS=0.35
STABLE_DIFFUSION_IMAGE_STRENGTH=0.35
STABLE_DIFFUSION_CFG_SCALE=8
STABLE_DIFFUSION_STEPS=30

# Legacy Midjourney proxy variables (optional compatibility path only).
# useapi.net Midjourney was discontinued on 2026-06-24; do not use it in prod.
MIDJOURNEY_API_KEY=
MIDJOURNEY_BASE_URL=
MIDJOURNEY_TIMEOUT_SECONDS=180
MIDJOURNEY_POLL_INTERVAL_SECONDS=3
MIDJOURNEY_MAX_POLL_ATTEMPTS=60
MIDJOURNEY_IMAGINE_PATH=/jobs/imagine
MIDJOURNEY_JOB_STATUS_PATH_TEMPLATE=/jobs/{job_id}

# Active provider-neutral webhook pool. JSON is parsed by Pydantic Settings.
# Add the exact paths/auth scheme required by your active proxy.
MIDJOURNEY_PROVIDERS=[]
MIDJOURNEY_CALLBACK_BASE_URL=https://api.example.com
MIDJOURNEY_WEBHOOK_TOKEN=replace_with_a_long_random_callback_token
MIDJOURNEY_REPLY_REF_SECRET=replace_with_a_different_long_random_hmac_secret
MIDJOURNEY_CALLBACK_TIMEOUT_SECONDS=600
MIDJOURNEY_CIRCUIT_BREAKER_FAILURES=3
MIDJOURNEY_CIRCUIT_BREAKER_TTL_SECONDS=180
# Shared AI Circuit Breaker (Anthropic / Midjourney / Vision / SD):
# 3× (429/500/502/503/timeout) within 60s → OPEN for 180s → HALF-OPEN probe.
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AI_CIRCUIT_BREAKER_FAILURE_WINDOW_SECONDS=60
AI_CIRCUIT_BREAKER_OPEN_DURATION_SECONDS=180
AI_CIRCUIT_BREAKER_PROBE_LOCK_SECONDS=30
MIDJOURNEY_GENERATION_COST_USD=0
# Geo preference for neural provider pool (plan §36). Example providers JSON:
# [{"name":"mj-nl","base_url":"https://…","api_key":"…","region":"eu-nl"},
#  {"name":"mj-de","base_url":"https://…","api_key":"…","region":"eu-de"}]
NEURAL_PREFERRED_REGION=eu-nl
NEURAL_FAILOVER_REGIONS=eu-de

# ==============================
# Geo failover + isolated PG backups (plan §36)
# See deploy/FAILOVER_PLAN.md
# ==============================
# Watchdog (run on jump/secondary host): python deploy/failover_watchdog.py
FAILOVER_PRIMARY_HEALTH_URL=http://PRIMARY_ORIGIN_IP:8000/health/ready
FAILOVER_SECONDARY_HEALTH_URL=http://SECONDARY_ORIGIN_IP:8000/health/ready
FAILOVER_PRIMARY_ORIGIN_IP=
FAILOVER_SECONDARY_ORIGIN_IP=
FAILOVER_DNS_RECORD_NAME=api.example.com
FAILOVER_DNS_RECORD_TYPE=A
FAILOVER_POLL_SECONDS=5
FAILOVER_FAIL_THRESHOLD=3
FAILOVER_RECOVER_THRESHOLD=6
FAILOVER_PROBE_TIMEOUT_SECONDS=3
FAILOVER_AUTO_FAILBACK=false
FAILOVER_DRY_RUN=false
# Isolated vault — NEVER reuse app S3_* credentials here
# Daily encrypted PG backups to cloud (plan §63). Use 21600 for 6h RPO (§36).
BACKUP_S3_ENDPOINT_URL=https://s3.ru-1.storage.selcloud.ru
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ru-1
BACKUP_ENCRYPTION_KEY=replace_with_32plus_chars_backup_encryption_secret
BACKUP_RETENTION_DAYS=14
BACKUP_PREFIX=pg/ai_card_master
BACKUP_INTERVAL_SECONDS=86400
BACKUP_NOTIFY_SUCCESS=false

# ==============================
# Automated Incident Response (plan §63)
# Host loop: python deploy/incident_recovery.py
# On critical CPU/RAM/disk/load or /health/ready fail:
#   flush Redis cache prefixes + docker compose restart api/worker/nginx
#   Telegram alert on any hardware pressure
# ==============================
INCIDENT_POLL_SECONDS=15
INCIDENT_FAIL_THRESHOLD=3
INCIDENT_COOLDOWN_SECONDS=300
INCIDENT_CPU_CRITICAL_PERCENT=92
INCIDENT_RAM_CRITICAL_PERCENT=92
INCIDENT_DISK_WARN_PERCENT=85
INCIDENT_DISK_CRITICAL_PERCENT=95
INCIDENT_LOAD_CRITICAL_PER_CPU=4
INCIDENT_HEALTH_URL=http://127.0.0.1/health/ready
INCIDENT_HEALTH_TIMEOUT_SECONDS=3
INCIDENT_COMPOSE_FILES=docker-compose.yml,deploy/docker-compose.scale.yml
INCIDENT_RESTART_SERVICES=api,worker,nginx
INCIDENT_REDIS_FLUSH_PREFIXES=claude:,analytics:,generation:history:,ab_test:,pain_analysis:,brand_lora:,catalog:,highload:
INCIDENT_ALERT_COOLDOWN_SECONDS=120
INCIDENT_DRY_RUN=false

# Face Fix post-processing provider. The model is called only for HD Face Fix mode.
FACE_FIX_API_KEY=
FACE_FIX_BASE_URL=
FACE_FIX_PATH=/v1/face-fix
FACE_FIX_MODEL_NAME=face-fix-auto
FACE_FIX_TIMEOUT_SECONDS=45
FACE_FIX_CONNECT_TIMEOUT_SECONDS=8
FACE_FIX_MAX_CONNECTIONS=80
FACE_FIX_MAX_RETRIES=2
FACE_FIX_COST_USD=0

# Redis / Celery. PostgreSQL remains the canonical job state.
# Cache Redis (volatile-lru): analytics/style/generation caches — always set TTL.
# Security Redis (noeviction in compose): rate limits, bans, CAPTCHA, DMS.
REDIS_URL=redis://localhost:6379/0
REDIS_SECURITY_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_OUTBOX_BATCH_SIZE=100

# Durable generation and image safety limits
GENERATION_JOB_TIMEOUT_SECONDS=1800
GENERATION_MAX_UPLOAD_BYTES=20971520
GENERATION_MAX_RESULT_BYTES=31457280
GENERATION_ALLOWED_RESULT_HOSTS=
GENERATION_CHARGE_COINS=true
GENERATION_FAST_COST_COINS=1
GENERATION_HD_FACE_FIX_COST_COINS=3
DAILY_BONUS_COINS=1
REFERRAL_BONUS_COINS=10
WORKSPACE_MAX_MANAGERS=3

# Signup trial anti-abuse (/api/v1/auth/register → 5 free coins when checks pass)
SIGNUP_TRIAL_ENABLED=true
SIGNUP_TRIAL_COINS=5
SIGNUP_TRIAL_SUBNET_MAX_ACCOUNTS=3
SIGNUP_TRIAL_SUBNET_TTL_SECONDS=86400
SIGNUP_TRIAL_FINGERPRINT_TTL_SECONDS=7776000
SIGNUP_TRIAL_PROXY_CHECK_ENABLED=true
SIGNUP_TRIAL_IP_API_ENABLED=true
SIGNUP_TRIAL_PROXY_TIMEOUT_SECONDS=2.5

# Silent ban: fingerprint/subnet abusers get is_flagged (no 403), 0 trial coins,
# shadow Celery queue for generations, and 1 req / 5 min on flagged IPs.
SILENT_BAN_ENABLED=true
SILENT_BAN_FLAGGED_IP_TTL_SECONDS=7776000
SILENT_BAN_FLAGGED_IP_RATE_LIMIT=1
SILENT_BAN_FLAGGED_IP_WINDOW_SECONDS=300
SILENT_BAN_SHADOW_DELAY_MIN_SECONDS=45
SILENT_BAN_SHADOW_DELAY_MAX_SECONDS=180
SILENT_BAN_EMULATE_HTTP_TIMEOUT=false

# Custom Brand LoRA (Pro / HalfYear / Year). Upload 20–30 refs → personal filter.
# Without REPLICATE_* credentials the synthetic BrandDNA trainer is used (prompt
# injection into Midjourney + SD). Real LoRA weights require Replicate.
BRAND_LORA_MIN_REFERENCES=20
BRAND_LORA_MAX_REFERENCES=30
BRAND_LORA_TRAINING_COST_COINS=50
BRAND_LORA_POLL_SECONDS=20
BRAND_LORA_POLL_BATCH_SIZE=50
BRAND_LORA_AUTO_ACTIVATE=true
BRAND_LORA_PREFER_REPLICATE=true

# BrandDNA (plan §58): learn style from successful generations → auto-mix into
# Midjourney + Claude prompts for brand-wide visual unity.
BRAND_DNA_ENABLED=true
BRAND_DNA_SAMPLE_LIMIT=25
BRAND_DNA_MIN_SAMPLES=1
REPLICATE_API_TOKEN=
REPLICATE_API_BASE_URL=https://api.replicate.com/v1
REPLICATE_TIMEOUT_SECONDS=60
REPLICATE_LORA_DESTINATION=
REPLICATE_LORA_DATASET_URL_OVERRIDE=
REPLICATE_LORA_TRAINER_MODEL=ostris/flux-dev-lora-trainer
REPLICATE_LORA_TRAINER_VERSION=latest
REPLICATE_LORA_TRAINING_STEPS=1000
REPLICATE_LORA_USE_MODEL_TRAININGS_ENDPOINT=false

# Direct Export + Marketplace Data Bridge (WB / Ozon / Amazon).
# Empty MARKETPLACE_CREDENTIALS_SECRET falls back to JWT_SECRET_KEY.
# Credentials are encrypted at rest with AES-256-GCM.
MARKETPLACE_CREDENTIALS_SECRET=
MARKETPLACE_EXPORT_TIMEOUT_SECONDS=30
MARKETPLACE_BRIDGE_TIMEOUT_SECONDS=45
WILDBERRIES_CONTENT_API_BASE_URL=https://content-api.wildberries.ru
WILDBERRIES_STATISTICS_API_BASE_URL=https://statistics-api.wildberries.ru
OZON_SELLER_API_BASE_URL=https://api-seller.ozon.ru

# Fail-Safe Export sandbox (plan §59): photo weight, forbidden words, category.
# On errors Claude 4.7 proposes a corrected title/description/characteristics.
FAIL_SAFE_EXPORT_ENABLED=true
FAIL_SAFE_EXPORT_CLAUDE_FIX_ENABLED=true

# Isolated stock parser (WB/Ozon mobile JSON — no Selenium/Puppeteer).
# Comma-separated egress proxies, e.g. http://user:pass@host:8080,socks5://host:1080
STOCK_PARSER_PROXY_URLS=
STOCK_PARSER_TIMEOUT_SECONDS=20
STOCK_PARSER_CIRCUIT_BREAKER_THRESHOLD=5
STOCK_PARSER_WB_CARD_BASE_URL=https://card.wb.ru
STOCK_PARSER_WB_DEST=-1257786
STOCK_PARSER_OZON_API_BASE_URL=https://api.ozon.ru
# Nightly Celery Beat (UTC) — one worker task handles at most CHUNK_SIZE SKUs.
STOCK_PARSER_CHUNK_SIZE=100
# Keyset page size for listing active SKUs (id > last); recommended 200–500.
STOCK_PARSER_KEYSET_BATCH_SIZE=300
STOCK_PARSER_BEAT_HOUR_UTC=3
STOCK_PARSER_BEAT_MINUTE_UTC=0

# Manual competitor-link audit (POST /api/v1/analytics/analyze-links)
# Empty COMPETITOR_AUDIT_PROXY_URLS falls back to STOCK_PARSER_PROXY_URLS.
COMPETITOR_AUDIT_PROXY_URLS=
COMPETITOR_AUDIT_TIMEOUT_SECONDS=25
COMPETITOR_AUDIT_REDIS_TTL_SECONDS=3600
COMPETITOR_AUDIT_MAX_REVIEWS=50
COMPETITOR_AUDIT_WB_CONTENT_BASE_URL=https://wbx-content-v2.wbstatic.net
COMPETITOR_AUDIT_MAX_VISION_IMAGES=5
COMPETITOR_AUDIT_IMAGE_TIMEOUT_SECONDS=20

# Parser ↔ Eye of God (Claude 4.7 Vision) — +30% sales / 3 days → money trigger JSON
EYE_OF_GOD_ENABLED=true
EYE_OF_GOD_RECENT_WINDOW_DAYS=3
EYE_OF_GOD_BASELINE_WINDOW_DAYS=7
EYE_OF_GOD_MIN_GROWTH_RATIO=0.30
EYE_OF_GOD_MIN_BASELINE_DAILY_SALES=1.0
EYE_OF_GOD_MIN_RECENT_RELIABLE_DAYS=2
EYE_OF_GOD_COOLDOWN_HOURS=24
EYE_OF_GOD_LOOKBACK_DAYS=21
EYE_OF_GOD_MAX_IMAGES=3
EYE_OF_GOD_IMAGE_TIMEOUT_SECONDS=20

AMAZON_SP_API_BASE_URL=https://sellingpartnerapi-eu.amazon.com

SMART_INPAINTING_EDGE_PASS_ENABLED=false
STYLE_CACHE_TTL_SECONDS=86400
STYLE_CACHE_VERSION=v1
GENERATION_HISTORY_CACHE_TTL_SECONDS=30
STATIC_CACHE_TTL_SECONDS=3600
GENERATION_STATUS_CACHE_TTL_SECONDS=5
GENERATION_STATUS_TERMINAL_CACHE_TTL_SECONDS=60

# Production pool / logging (plan §16)
LOG_LEVEL=INFO
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
TELEGRAM_ERROR_LOGGING_ENABLED=true
TELEGRAM_ERROR_ALERT_COOLDOWN_SECONDS=60

# LLM integration for infographic headlines
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com
LLM_TIMEOUT_SECONDS=25
LLM_MAX_CONNECTIONS=80
LLM_MAX_KEEPALIVE_CONNECTIONS=40
LLM_MAX_RETRIES=2
LLM_BASE_RETRY_DELAY_SECONDS=0.35

# YooKassa (payments + async webhooks)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=http://localhost:3000/payments/return
YOOKASSA_TIMEOUT_SECONDS=30
YOOKASSA_MAX_RETRIES=2
YOOKASSA_BASE_RETRY_DELAY_SECONDS=0.5
YOOKASSA_VAT_CODE=1

# Selectel S3-compatible storage (series ZIP archives)
S3_ENDPOINT_URL=https://s3.ru-1.storage.selcloud.ru
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=ru-1
S3_ADDRESSING_STYLE=path
S3_PRESIGN_TTL_SECONDS=3600

# Sentry (optional; leave SENTRY_DSN empty to disable)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Critical 500 alerts (optional Telegram bot integration)
TELEGRAM_ERROR_BOT_TOKEN=
TELEGRAM_ERROR_CHAT_ID=
TELEGRAM_ERROR_TIMEOUT_SECONDS=5

# User-facing Telegram bot for Win-back / style-update triggers
# (falls back to TELEGRAM_ERROR_BOT_TOKEN when empty)
TELEGRAM_USER_BOT_TOKEN=
TELEGRAM_USER_TIMEOUT_SECONDS=5

# Churn Prevention / Win-back
WINBACK_INACTIVITY_DAYS=10
WINBACK_FREE_GENERATIONS=5
WINBACK_DISCOUNT_PERCENT=30
WINBACK_OFFER_TTL_HOURS=72
WINBACK_INACTIVITY_SCAN_SECONDS=3600
WINBACK_STYLE_UPDATE_SCAN_SECONDS=86400
WINBACK_STYLE_CAMPAIGN_KEY=luxury_loft_update_v1

# Zero-Knowledge source retention (Celery beat): purge heavy ZIP + originals
# after N hours; thumbnails stay for history. Status in DB → deleted.
SOURCE_RETENTION_HOURS=24
SOURCE_RETENTION_SCAN_SECONDS=900
SOURCE_RETENTION_BATCH_SIZE=200

# Bulk Generation (ZIP of up to 20 products)
BULK_GENERATION_MAX_PRODUCTS=20
BULK_GENERATION_MAX_ZIP_BYTES=209715200
BULK_GENERATION_POLL_SECONDS=15
BULK_GENERATION_POLL_BATCH_SIZE=50

# Smart Variant Sync (1 photo → N fabric colors)
SMART_VARIANT_MAX_COLORS=10
SMART_VARIANT_POLL_SECONDS=15
SMART_VARIANT_POLL_BATCH_SIZE=50

# Claude 4.7 Opus Vision & Reasoning Integration Layer
# ANTHROPIC_API_KEY is an accepted alias for CLAUDE_47_API_KEY
CLAUDE_47_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_47_BASE_URL=https://api.anthropic.com
# Optional Anthropic-compatible proxy when primary circuit is OPEN
CLAUDE_FALLBACK_BASE_URL=
CLAUDE_47_MODEL=claude-opus-4-7
# Plan §55 — cheap model for simple text analytics (pain/oracle/AB/strategy)
# Also Circuit Breaker fallback when Opus/Sonnet primary is OPEN
CLAUDE_35_HAIKU_MODEL=claude-3-5-haiku-20241022
CLAUDE_47_API_VERSION=2023-06-01
CLAUDE_47_STRUCTURED_OUTPUTS_BETA=
CLAUDE_47_TIMEOUT_SECONDS=120
CLAUDE_47_MAX_CONNECTIONS=40
CLAUDE_47_MAX_KEEPALIVE_CONNECTIONS=20
CLAUDE_47_MAX_RETRIES=2
CLAUDE_47_BASE_RETRY_DELAY_SECONDS=0.5
# Unused by Opus 4.7 requests (adaptive thinking + effort instead); used by Haiku
CLAUDE_47_TEMPERATURE=0.2
CLAUDE_47_EFFORT=high
CLAUDE_47_VISION_MAX_TOKENS=4096
CLAUDE_47_REASONING_MAX_TOKENS=4096
CLAUDE_47_MAX_IMAGES_PER_REQUEST=5
# Stage + content-addressed analytics cache TTL (24h → API cost savings)
CLAUDE_47_STAGE_CACHE_TTL_SECONDS=86400
CLAUDE_ANALYTICS_CACHE_TTL_SECONDS=86400
CLAUDE_47_PROCESSING_TIMEOUT_SECONDS=900
CLAUDE_47_OUTBOX_BATCH_SIZE=100
CLAUDE_47_RECOVERY_BATCH_SIZE=50
# Admin cost monitoring for Anthropic Claude 4.7-compatible usage accounting.
CLAUDE_47_INPUT_1K_TOKENS_COST_USD=0
CLAUDE_47_OUTPUT_1K_TOKENS_COST_USD=0

# Plan §80 — AI Cost Dashboard & Resource Analytics
# Daily USD budget for Telegram alerts (0 disables budget alert when paired with ratio checks)
COST_DAILY_LIMIT_USD=50
# Alert when avg generation cost ≥ ratio × previous-week baseline
COST_GENERATION_SPIKE_RATIO=2.0
# Alert when avg API latency ≥ ratio × previous-week baseline
COST_LATENCY_SPIKE_RATIO=2.0
# Absolute avg latency threshold (ms)
COST_LATENCY_WARN_MS=15000
# Known sale price per generation for profitability (0 = unknown)
COST_GENERATION_SALE_PRICE_USD=0
COST_ALERTS_ENABLED=true
COST_ALERT_COOLDOWN_SECONDS=3600

# Plan §81 — Enterprise Audit Log & Event Tracking
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_ARCHIVE_ENABLED=true
AUDIT_LOG_ARCHIVE_BATCH_SIZE=1000
# Celery beat interval (seconds) for automatic archival
AUDIT_LOG_ARCHIVE_SCAN_SECONDS=86400
AUDIT_LOG_ADMIN_ACCESS_ENABLED=true
# Structured logs → ELK / Grafana Loki (domain stays backend-agnostic)
AUDIT_LOG_STRUCTURED_EXPORT_ENABLED=true
AUDIT_REQUEST_ID_HEADER=X-Request-Id

# Plan §69 — AI Token & Resource Governor (Economy 2.0)
# Semantic Filtering (Delta) + optional local LLM for routine text tasks.
TOKEN_GOVERNOR_ENABLED=true
TOKEN_GOVERNOR_SOFT_INPUT_TOKENS=6000
TOKEN_GOVERNOR_HARD_INPUT_TOKENS=24000
TOKEN_GOVERNOR_ALWAYS_SEMANTIC_FILTER=true
TOKEN_GOVERNOR_PREFER_LOCAL=true
# Prior competitor card snapshots for Delta (7 days)
TOKEN_GOVERNOR_SNAPSHOT_TTL_SECONDS=604800
# Ollama / Llama 3 on your server (classification & primary text prep)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=60

# Intelligent visual audit (Brand Dominant → Rising Stars → generator JSON)
VISUAL_AUDIT_TOP_N=50
VISUAL_AUDIT_BRAND_DOMINANT_SOFT_REVIEWS=5000
VISUAL_AUDIT_BRAND_DOMINANT_HARD_REVIEWS=7000
VISUAL_AUDIT_RISING_MIN_REVIEWS=50
VISUAL_AUDIT_RISING_MAX_REVIEWS=1500
VISUAL_AUDIT_MIN_SALES_GROWTH_RATIO=0.30
VISUAL_AUDIT_MIN_REVIEW_VELOCITY_PER_DAY=3.0
VISUAL_AUDIT_MAX_RISING_STARS_FOR_VISION=12

# Market Gap & Trend Prediction (The Oracle)
ORACLE_MIN_QUERY_GROWTH_RATIO=0.25
ORACLE_MIN_RECENT_QUERY_VOLUME=500
ORACLE_MAX_TOP_CARDS_FOR_GAP=3
ORACLE_MIN_GAP_SCORE=40.0
ORACLE_MAX_ALERTS=10
ORACLE_TOP_RANK_CEILING=50

# Strategic Killer Recommendations (AI Strategy)
AI_STRATEGY_MIN_CTR_LIFT_PCT=5.0
AI_STRATEGY_MIN_ABSOLUTE_CTR_GAP=0.5
AI_STRATEGY_MAX_RECOMMENDATIONS=7
AI_STRATEGY_REQUIRE_LEADER_CTR_ADVANTAGE=true

# ==============================
# IaC / One-Click Deploy (plan §40)
# Inventory: deploy/inventory.json — Terraform: deploy/terraform/
# Docs: deploy/IAC.md
#   bash deploy/one_click_deploy.sh --profile production_tunnel
#   python deploy/one_click_deploy.py --dry-run --profile production
#   powershell -File deploy/one_click_deploy.ps1 -DryRun -Profile production
# After terraform apply: set FAILOVER_* from outputs primary_ipv4 / secondary_ipv4
# ==============================
DEPLOY_PROFILE=production_tunnel
ONE_CLICK_HEALTH_URL=
# POSTGRES_PASSWORD is REQUIRED by docker-compose (no default).
# Rejected by deploy validators when set to changeme_in_production.
POSTGRES_PASSWORD=

# ==============================
# Launch / autoscaling (plan §24)
# Use with: docker compose -f docker-compose.yml -f deploy/docker-compose.scale.yml
# Autoscale loop: python deploy/autoscale.py
# Rollback: bash deploy/rollback.sh   (Windows: deploy/rollback.ps1)
# ==============================
IMAGE_TAG=current
PUBLIC_HTTP_PORT=80
API_REPLICAS=1
WORKER_REPLICAS=1
AUTOSCALE_API_MIN=1
AUTOSCALE_API_MAX=4
AUTOSCALE_WORKER_MIN=1
AUTOSCALE_WORKER_MAX=6
AUTOSCALE_SCALE_UP_DEPTH=20
AUTOSCALE_SCALE_DOWN_DEPTH=2
AUTOSCALE_POLL_SECONDS=30
AUTOSCALE_COOLDOWN_SECONDS=90
AUTOSCALE_HEALTH_URL=http://127.0.0.1/health/ready
AUTOSCALE_HEALTH_SLOW_MS=1500
AUTOSCALE_COMPOSE_FILES=docker-compose.yml,deploy/docker-compose.scale.yml
AUTOSCALE_DRY_RUN=false
# Optional resource caps for the scale overlay (Compose deploy.resources)
AUTOSCALE_API_CPU_LIMIT=1.0
AUTOSCALE_API_MEMORY_LIMIT=1G
AUTOSCALE_WORKER_CPU_LIMIT=1.5
AUTOSCALE_WORKER_MEMORY_LIMIT=2G
