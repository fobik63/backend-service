# ==============================
# AI-Card-Master backend config
# ==============================

# Environment
APP_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_card_master

# JWT (must be strong, random, and at least 64 chars)
JWT_SECRET_KEY=replace_with_a_strong_random_secret_at_least_64_characters_long
JWT_ALGORITHM=HS512
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=ai-card-master-api
JWT_AUDIENCE=ai-card-master-clients

# Optional secret value mixed with user passwords before hashing
PASSWORD_PEPPER=

# Argon2id profile (tune for your hardware)
ARGON2_MEMORY_COST_KIB=131072
ARGON2_TIME_COST=4
ARGON2_PARALLELISM=4

# CORS — Next.js (and other) frontend origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# ==============================
# Legal / GDPR (Terms + Privacy)
# Required for payment acceptance — replace placeholders before production.
# ==============================
SERVICE_DISPLAY_NAME=AI-Card-Master
PUBLIC_SITE_URL=https://ai-card-master.example
LEGAL_OPERATOR_NAME=[УКАЖИТЕ ЮРИДИЧЕСКОЕ НАИМЕНОВАНИЕ ОПЕРАТОРА]
LEGAL_OPERATOR_ADDRESS=[УКАЖИТЕ ЮРИДИЧЕСКИЙ АДРЕС ОПЕРАТОРА]
LEGAL_JURISDICTION=Российская Федерация
SUPPORT_EMAIL=support@example.com
PRIVACY_EMAIL=privacy@example.com
LEGAL_DOCUMENTS_EFFECTIVE_DATE=2026-08-07

# Hidden admin API. Set to your exact user UUID; empty disables /api/v1/admin.
ADMIN_ALLOWED_USER_ID=

# ==============================
# Security layer (plan §14)
# ==============================
SECURITY_SUSPICIOUS_MIDDLEWARE_ENABLED=true
SECURITY_INPUT_SANITIZATION_ENABLED=true
SECURITY_REJECT_PROMPT_INJECTION=true
# Per-IP request budget (Redis). Fail-open if Redis is down.
SECURITY_RATE_LIMIT_PER_MINUTE=120
# Auto temp-ban after N threat hits within 1 hour
SECURITY_AUTO_BLOCK_THREAT_SCORE=5
SECURITY_IP_BLOCK_TTL_SECONDS=3600
SECURITY_MAX_JSON_BODY_BYTES=1048576
# Extra reverse-proxy CIDRs that may set X-Forwarded-For / CF-Connecting-IP
TRUSTED_PROXY_CIDRS=

# Cloudflare (orange-cloud DNS + origin allowlist CF IPs only — hide real IP / DDoS)
CLOUDFLARE_ENABLED=false
# Production: reject direct-to-origin traffic missing CF-Ray / CF-Connecting-IP
CLOUDFLARE_ENFORCE_EDGE=false
CLOUDFLARE_TRUST_HEADERS=true
CLOUDFLARE_AUTO_BAN_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com
CLOUDFLARE_TIMEOUT_SECONDS=10

# Isolated admin microservice (AES-256-GCM token; not user JWT)
# Bind to localhost / private net only; put behind VPN or Cloudflare Access.
ADMIN_PANEL_TOKEN_SECRET=replace_with_a_separate_strong_secret_at_least_32_chars
ADMIN_PANEL_BIND_HOST=127.0.0.1
ADMIN_PANEL_PORT=8100
ADMIN_PANEL_CORS_ORIGINS=
# Mint token:  python -m admin_microservice.mint_token --label ops --ttl-days 30
# Run:         uvicorn admin_microservice.main:app --host 127.0.0.1 --port 8100

# Stable Diffusion (Free tariff / fallback engine)
STABLE_DIFFUSION_API_KEY=
STABLE_DIFFUSION_BASE_URL=https://api.stability.ai
STABLE_DIFFUSION_ENGINE_ID=stable-diffusion-xl-1024-v1-0
STABLE_DIFFUSION_TIMEOUT_SECONDS=60
STABLE_DIFFUSION_CONNECT_TIMEOUT_SECONDS=8
STABLE_DIFFUSION_MAX_CONNECTIONS=300
STABLE_DIFFUSION_MAX_KEEPALIVE_CONNECTIONS=120
STABLE_DIFFUSION_KEEPALIVE_EXPIRY_SECONDS=30
STABLE_DIFFUSION_MAX_PARALLEL_REQUESTS=200
STABLE_DIFFUSION_MAX_RETRIES=3
STABLE_DIFFUSION_BASE_RETRY_DELAY_SECONDS=0.35
STABLE_DIFFUSION_IMAGE_STRENGTH=0.35
STABLE_DIFFUSION_CFG_SCALE=8
STABLE_DIFFUSION_STEPS=30

# Legacy Midjourney proxy variables (optional compatibility path only).
# useapi.net Midjourney was discontinued on 2026-06-24; do not use it in prod.
MIDJOURNEY_API_KEY=
MIDJOURNEY_BASE_URL=
MIDJOURNEY_TIMEOUT_SECONDS=180
MIDJOURNEY_POLL_INTERVAL_SECONDS=3
MIDJOURNEY_MAX_POLL_ATTEMPTS=60
MIDJOURNEY_IMAGINE_PATH=/jobs/imagine
MIDJOURNEY_JOB_STATUS_PATH_TEMPLATE=/jobs/{job_id}

# Active provider-neutral webhook pool. JSON is parsed by Pydantic Settings.
# Add the exact paths/auth scheme required by your active proxy.
MIDJOURNEY_PROVIDERS=[]
MIDJOURNEY_CALLBACK_BASE_URL=https://api.example.com
MIDJOURNEY_WEBHOOK_TOKEN=replace_with_a_long_random_callback_token
MIDJOURNEY_REPLY_REF_SECRET=replace_with_a_different_long_random_hmac_secret
MIDJOURNEY_CALLBACK_TIMEOUT_SECONDS=600
MIDJOURNEY_CIRCUIT_BREAKER_FAILURES=3
MIDJOURNEY_CIRCUIT_BREAKER_TTL_SECONDS=120
MIDJOURNEY_GENERATION_COST_USD=0

# Face Fix post-processing provider. The model is called only for HD Face Fix mode.
FACE_FIX_API_KEY=
FACE_FIX_BASE_URL=
FACE_FIX_PATH=/v1/face-fix
FACE_FIX_MODEL_NAME=face-fix-auto
FACE_FIX_TIMEOUT_SECONDS=45
FACE_FIX_CONNECT_TIMEOUT_SECONDS=8
FACE_FIX_MAX_CONNECTIONS=80
FACE_FIX_MAX_RETRIES=2
FACE_FIX_COST_USD=0

# Redis / Celery. PostgreSQL remains the canonical job state.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_OUTBOX_BATCH_SIZE=100

# Durable generation and image safety limits
GENERATION_JOB_TIMEOUT_SECONDS=1800
GENERATION_MAX_UPLOAD_BYTES=20971520
GENERATION_MAX_RESULT_BYTES=31457280
GENERATION_ALLOWED_RESULT_HOSTS=
GENERATION_CHARGE_COINS=true
GENERATION_FAST_COST_COINS=1
GENERATION_HD_FACE_FIX_COST_COINS=3
DAILY_BONUS_COINS=1
REFERRAL_BONUS_COINS=10
WORKSPACE_MAX_MANAGERS=3

# Direct Export + Marketplace Data Bridge (WB / Ozon / Amazon).
# Empty MARKETPLACE_CREDENTIALS_SECRET falls back to JWT_SECRET_KEY.
# Credentials are encrypted at rest with AES-256-GCM.
MARKETPLACE_CREDENTIALS_SECRET=
MARKETPLACE_EXPORT_TIMEOUT_SECONDS=30
MARKETPLACE_BRIDGE_TIMEOUT_SECONDS=45
WILDBERRIES_CONTENT_API_BASE_URL=https://content-api.wildberries.ru
WILDBERRIES_STATISTICS_API_BASE_URL=https://statistics-api.wildberries.ru
OZON_SELLER_API_BASE_URL=https://api-seller.ozon.ru

# Isolated stock parser (WB/Ozon mobile JSON — no Selenium/Puppeteer).
# Comma-separated egress proxies, e.g. http://user:pass@host:8080,socks5://host:1080
STOCK_PARSER_PROXY_URLS=
STOCK_PARSER_TIMEOUT_SECONDS=20
STOCK_PARSER_CIRCUIT_BREAKER_THRESHOLD=5
STOCK_PARSER_WB_CARD_BASE_URL=https://card.wb.ru
STOCK_PARSER_WB_DEST=-1257786
STOCK_PARSER_OZON_API_BASE_URL=https://api.ozon.ru
# Nightly Celery Beat (UTC) — one worker task handles at most CHUNK_SIZE SKUs.
STOCK_PARSER_CHUNK_SIZE=100
STOCK_PARSER_BEAT_HOUR_UTC=3
STOCK_PARSER_BEAT_MINUTE_UTC=0

# Manual competitor-link audit (POST /api/v1/analytics/analyze-links)
# Empty COMPETITOR_AUDIT_PROXY_URLS falls back to STOCK_PARSER_PROXY_URLS.
COMPETITOR_AUDIT_PROXY_URLS=
COMPETITOR_AUDIT_TIMEOUT_SECONDS=25
COMPETITOR_AUDIT_REDIS_TTL_SECONDS=3600
COMPETITOR_AUDIT_MAX_REVIEWS=50
COMPETITOR_AUDIT_WB_CONTENT_BASE_URL=https://wbx-content-v2.wbstatic.net
COMPETITOR_AUDIT_MAX_VISION_IMAGES=5
COMPETITOR_AUDIT_IMAGE_TIMEOUT_SECONDS=20

# Parser ↔ Eye of God (Claude 4.7 Vision) — +30% sales / 3 days → money trigger JSON
EYE_OF_GOD_ENABLED=true
EYE_OF_GOD_RECENT_WINDOW_DAYS=3
EYE_OF_GOD_BASELINE_WINDOW_DAYS=7
EYE_OF_GOD_MIN_GROWTH_RATIO=0.30
EYE_OF_GOD_MIN_BASELINE_DAILY_SALES=1.0
EYE_OF_GOD_MIN_RECENT_RELIABLE_DAYS=2
EYE_OF_GOD_COOLDOWN_HOURS=24
EYE_OF_GOD_LOOKBACK_DAYS=21
EYE_OF_GOD_MAX_IMAGES=3
EYE_OF_GOD_IMAGE_TIMEOUT_SECONDS=20

AMAZON_SP_API_BASE_URL=https://sellingpartnerapi-eu.amazon.com

SMART_INPAINTING_EDGE_PASS_ENABLED=false
STYLE_CACHE_TTL_SECONDS=86400
STYLE_CACHE_VERSION=v1
GENERATION_HISTORY_CACHE_TTL_SECONDS=30
STATIC_CACHE_TTL_SECONDS=3600
GENERATION_STATUS_CACHE_TTL_SECONDS=5
GENERATION_STATUS_TERMINAL_CACHE_TTL_SECONDS=60

# Production pool / logging (plan §16)
LOG_LEVEL=INFO
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE_SECONDS=1800
TELEGRAM_ERROR_LOGGING_ENABLED=true
TELEGRAM_ERROR_ALERT_COOLDOWN_SECONDS=60

# LLM integration for infographic headlines
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com
LLM_TIMEOUT_SECONDS=25
LLM_MAX_CONNECTIONS=80
LLM_MAX_KEEPALIVE_CONNECTIONS=40
LLM_MAX_RETRIES=2
LLM_BASE_RETRY_DELAY_SECONDS=0.35

# YooKassa (payments + async webhooks)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=http://localhost:3000/payments/return
YOOKASSA_TIMEOUT_SECONDS=30
YOOKASSA_MAX_RETRIES=2
YOOKASSA_BASE_RETRY_DELAY_SECONDS=0.5
YOOKASSA_VAT_CODE=1

# Selectel S3-compatible storage (series ZIP archives)
S3_ENDPOINT_URL=https://s3.ru-1.storage.selcloud.ru
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=ru-1
S3_ADDRESSING_STYLE=path
S3_PRESIGN_TTL_SECONDS=3600

# Critical 500 alerts (optional Telegram bot integration)
TELEGRAM_ERROR_BOT_TOKEN=
TELEGRAM_ERROR_CHAT_ID=
TELEGRAM_ERROR_TIMEOUT_SECONDS=5

# User-facing Telegram bot for Win-back / style-update triggers
# (falls back to TELEGRAM_ERROR_BOT_TOKEN when empty)
TELEGRAM_USER_BOT_TOKEN=
TELEGRAM_USER_TIMEOUT_SECONDS=5

# Churn Prevention / Win-back
WINBACK_INACTIVITY_DAYS=10
WINBACK_FREE_GENERATIONS=5
WINBACK_DISCOUNT_PERCENT=30
WINBACK_OFFER_TTL_HOURS=72
WINBACK_INACTIVITY_SCAN_SECONDS=3600
WINBACK_STYLE_UPDATE_SCAN_SECONDS=86400
WINBACK_STYLE_CAMPAIGN_KEY=luxury_loft_update_v1

# Bulk Generation (ZIP of up to 20 products)
BULK_GENERATION_MAX_PRODUCTS=20
BULK_GENERATION_MAX_ZIP_BYTES=209715200
BULK_GENERATION_POLL_SECONDS=15
BULK_GENERATION_POLL_BATCH_SIZE=50

# Smart Variant Sync (1 photo → N fabric colors)
SMART_VARIANT_MAX_COLORS=10
SMART_VARIANT_POLL_SECONDS=15
SMART_VARIANT_POLL_BATCH_SIZE=50

# Claude 4.7 Opus Vision & Reasoning Integration Layer
# ANTHROPIC_API_KEY is an accepted alias for CLAUDE_47_API_KEY
CLAUDE_47_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_47_BASE_URL=https://api.anthropic.com
CLAUDE_47_MODEL=claude-opus-4-7
CLAUDE_47_API_VERSION=2023-06-01
CLAUDE_47_STRUCTURED_OUTPUTS_BETA=
CLAUDE_47_TIMEOUT_SECONDS=120
CLAUDE_47_MAX_CONNECTIONS=40
CLAUDE_47_MAX_KEEPALIVE_CONNECTIONS=20
CLAUDE_47_MAX_RETRIES=2
CLAUDE_47_BASE_RETRY_DELAY_SECONDS=0.5
# Unused by Opus 4.7 requests (adaptive thinking + effort instead)
CLAUDE_47_TEMPERATURE=0.2
CLAUDE_47_EFFORT=high
CLAUDE_47_VISION_MAX_TOKENS=4096
CLAUDE_47_REASONING_MAX_TOKENS=4096
CLAUDE_47_MAX_IMAGES_PER_REQUEST=5
CLAUDE_47_STAGE_CACHE_TTL_SECONDS=3600
CLAUDE_47_PROCESSING_TIMEOUT_SECONDS=900
CLAUDE_47_OUTBOX_BATCH_SIZE=100
CLAUDE_47_RECOVERY_BATCH_SIZE=50
# Admin cost monitoring for Anthropic Claude 4.7-compatible usage accounting.
CLAUDE_47_INPUT_1K_TOKENS_COST_USD=0
CLAUDE_47_OUTPUT_1K_TOKENS_COST_USD=0

# Intelligent visual audit (Brand Dominant → Rising Stars → generator JSON)
VISUAL_AUDIT_TOP_N=50
VISUAL_AUDIT_BRAND_DOMINANT_SOFT_REVIEWS=5000
VISUAL_AUDIT_BRAND_DOMINANT_HARD_REVIEWS=7000
VISUAL_AUDIT_RISING_MIN_REVIEWS=50
VISUAL_AUDIT_RISING_MAX_REVIEWS=1500
VISUAL_AUDIT_MIN_SALES_GROWTH_RATIO=0.30
VISUAL_AUDIT_MIN_REVIEW_VELOCITY_PER_DAY=3.0
VISUAL_AUDIT_MAX_RISING_STARS_FOR_VISION=12

# Market Gap & Trend Prediction (The Oracle)
ORACLE_MIN_QUERY_GROWTH_RATIO=0.25
ORACLE_MIN_RECENT_QUERY_VOLUME=500
ORACLE_MAX_TOP_CARDS_FOR_GAP=3
ORACLE_MIN_GAP_SCORE=40.0
ORACLE_MAX_ALERTS=10
ORACLE_TOP_RANK_CEILING=50

# Strategic Killer Recommendations (AI Strategy)
AI_STRATEGY_MIN_CTR_LIFT_PCT=5.0
AI_STRATEGY_MIN_ABSOLUTE_CTR_GAP=0.5
AI_STRATEGY_MAX_RECOMMENDATIONS=7
AI_STRATEGY_REQUIRE_LEADER_CTR_ADVANTAGE=true

# ==============================
# Launch / autoscaling (plan §24)
# Use with: docker compose -f docker-compose.yml -f deploy/docker-compose.scale.yml
# Autoscale loop: python deploy/autoscale.py
# Rollback: bash deploy/rollback.sh   (Windows: deploy/rollback.ps1)
# ==============================
IMAGE_TAG=current
PUBLIC_HTTP_PORT=80
API_REPLICAS=1
WORKER_REPLICAS=1
AUTOSCALE_API_MIN=1
AUTOSCALE_API_MAX=4
AUTOSCALE_WORKER_MIN=1
AUTOSCALE_WORKER_MAX=6
AUTOSCALE_SCALE_UP_DEPTH=20
AUTOSCALE_SCALE_DOWN_DEPTH=2
AUTOSCALE_POLL_SECONDS=30
AUTOSCALE_COOLDOWN_SECONDS=90
AUTOSCALE_HEALTH_URL=http://127.0.0.1/health/ready
AUTOSCALE_HEALTH_SLOW_MS=1500
AUTOSCALE_COMPOSE_FILES=docker-compose.yml,deploy/docker-compose.scale.yml
AUTOSCALE_DRY_RUN=false
# Optional resource caps for the scale overlay (Compose deploy.resources)
AUTOSCALE_API_CPU_LIMIT=1.0
AUTOSCALE_API_MEMORY_LIMIT=1G
AUTOSCALE_WORKER_CPU_LIMIT=1.5
AUTOSCALE_WORKER_MEMORY_LIMIT=2G
