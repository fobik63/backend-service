# ==============================
# AI-Card-Master web (Next.js)
# Copy to `.env.local` for local overrides.
# ==============================

# Backend API. Keep localhost for PC; when you open the Network URL on a phone,
# the client rewrites localhost → your LAN IP automatically (same Wi-Fi).
# Or set the LAN IP explicitly, e.g. http://192.168.1.13:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Client mock mode (skip OTP + fake AI generate). Keep false for real API.
NEXT_PUBLIC_IS_MOCK=false

# Telegram Login Widget bot username (without @). Must match TELEGRAM_LOGIN_BOT_TOKEN on backend.
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername

# ==============================
# Marketplace parser (server-side BFF /api/parse)
# Temporary stub: cheerio reads <title> + meta description when MP scrapers fail.
# Used by web/lib/parser — ready for production egress hardening.
# ==============================

# Rotating HTTP(S) proxies (comma / newline separated). Empty = direct IP.
# Example: http://user:pass@1.2.3.4:8080,http://5.6.7.8:3128
PARSER_PROXY_URLS=

# Jittered delay between WB/Ozon requests (ms) — protects local / server IP.
PARSER_REQUEST_DELAY_MS_MIN=400
PARSER_REQUEST_DELAY_MS_MAX=1200

# Optional marketplace endpoint overrides
# PARSER_WB_CARD_BASE_URL=https://card.wb.ru
# PARSER_WB_CONTENT_BASE_URL=https://wbx-content-v2.wbstatic.net
# PARSER_WB_DEST=-1257786

# ==============================
# Future LLM keys (web BFF / edge)
# Prefer keeping secrets on the FastAPI backend; these slots are for a later
# Next.js server-only path. Never prefix secrets with NEXT_PUBLIC_.
# ==============================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=https://api.openai.com
