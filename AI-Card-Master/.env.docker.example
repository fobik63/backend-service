# Copy to `.env` next to docker-compose.yml before `docker compose up`.
#   cp .env.docker.example .env

APP_ENV=production
IMAGE_TAG=current
LOG_LEVEL=INFO

# Required — change before any real deployment
POSTGRES_PASSWORD=change_me_strong_postgres_password

# JWT (≥ 64 chars) and password pepper (≥ 32 chars) — required in production
JWT_SECRET_KEY=replace_with_a_strong_random_secret_at_least_64_characters_long_xx
JWT_ALGORITHM=HS512
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=ai-card-master-api
JWT_AUDIENCE=ai-card-master-clients
PASSWORD_PEPPER=replace_with_another_strong_secret_min_32_chars

# Distinct from JWT_SECRET_KEY (≥ 32 chars) — required in production
ADMIN_PANEL_TOKEN_SECRET=replace_with_admin_panel_secret_min_32_chars_xx

# Must be false in production
CAPTCHA_BYPASS_WHEN_UNCONFIGURED=false

# Browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js (baked at image build time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_IS_MOCK=false

# Optional: Telegram Login Widget bot username (without @)
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Process sizing for local/isolated smoke runs
UVICORN_WORKERS=2
CELERY_CONCURRENCY=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Legal placeholders (replace before accepting payments)
SERVICE_DISPLAY_NAME=AI-Card-Master
PUBLIC_SITE_URL=http://localhost:3000
LEGAL_OPERATOR_NAME=[УКАЖИТЕ ЮРИДИЧЕСКОЕ НАИМЕНОВАНИЕ ОПЕРАТОРА]
LEGAL_OPERATOR_ADDRESS=[УКАЖИТЕ ЮРИДИЧЕСКИЙ АДРЕС ОПЕРАТОРА]
LEGAL_JURISDICTION=Российская Федерация
SUPPORT_EMAIL=support@example.com
PRIVACY_EMAIL=privacy@example.com
LEGAL_DOCUMENTS_EFFECTIVE_DATE=2026-08-07
